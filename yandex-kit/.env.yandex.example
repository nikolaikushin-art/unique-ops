# Copy to .env.yandex and fill in real values.
# Used by docker-compose.yml for the self-hosted Supabase stack.

# --- App ---
APP_URL=https://ops.uniquedetailing.ru
COMPANY_NAME=Unique Detailing

# --- Yandex Managed Service for PostgreSQL ---
PG_HOST=
PG_PORT=6432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
# Full connection string built from the above, sslmode=require for Yandex MDB
DATABASE_URL=postgres://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DATABASE}?sslmode=require

# --- Auth (GoTrue) ---
# Generate a fresh secret — do NOT reuse the old Supabase project's JWT secret
JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Realtime ---
REALTIME_SECRET_KEY_BASE=

# --- Yandex Object Storage (replaces both R2 and legacy Supabase Storage buckets) ---
YC_STORAGE_BUCKET=
YC_STORAGE_ACCESS_KEY=
YC_STORAGE_SECRET_KEY=

# --- Yandex Cloud Postbox (replaces Resend) ---
# SMTP path — used by GoTrue for password-reset/invite emails
POSTBOX_SMTP_HOST=postbox.cloud.yandex.net
POSTBOX_SMTP_PORT=465
POSTBOX_SMTP_USER=
POSTBOX_SMTP_PASSWORD=
# AWS SES-compatible API path — used by send-invoice/send-notification (see email-postbox-adapter-notes.md)
POSTBOX_API_ENDPOINT=https://postbox.cloud.yandex.net
POSTBOX_ACCESS_KEY_ID=
POSTBOX_SECRET_ACCESS_KEY=
INVOICE_FROM_EMAIL=Unique Detailing <invoices@uniquedetailing.ru>
NOTIFICATION_FROM_EMAIL=Unique Detailing <notify@uniquedetailing.ru>

# --- Frontend (Vite) — what changes in Vercel once cutover happens ---
# VITE_SUPABASE_URL=https://<your-kong-domain>   (was https://flqgrcmevbjavafppqmh.supabase.co)
# VITE_SUPABASE_ANON_KEY=<same as SUPABASE_ANON_KEY above>

# --- File storage provider switch (frontend, Vite) ---
# 'local' (or unset) = browser IndexedDB, only useful for local dev/demo.
# 'yandex' = real Yandex Object Storage via presigned URLs (see functions/storage-presign)
VITE_STORAGE_PROVIDER=yandex
VITE_STORAGE_PRESIGN_URL=
VITE_STORAGE_PUBLIC_BASE=https://${YC_STORAGE_BUCKET}.storage.yandexcloud.net

# --- storage-presign Cloud Function's own env (deployed separately, see
# functions/storage-presign/index.mjs header comment for the deploy command) ---
# YC_STORAGE_BUCKET / YC_STORAGE_ACCESS_KEY / YC_STORAGE_SECRET_KEY: same values as above.
# JWT_SECRET: same value as GoTrue's JWT_SECRET above (the function verifies GoTrue-issued tokens).
